<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== ТЪМНА ТЕМА (Midnight Slate & Indigo) ==========
         Всички ключове трябва да съществуват и в Light.xaml.
         Използват се навсякъде чрез {DynamicResource ...}, за да се сменят на живо. -->

    <!-- Повърхности -->
    <SolidColorBrush x:Key="CanvasBrush"        Color="#0B1020" />
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#121A2B" />
    <SolidColorBrush x:Key="SurfaceAltBrush"    Color="#182236" />
    <SolidColorBrush x:Key="LineBrush"          Color="#222D44" />
    <SolidColorBrush x:Key="LineStrongBrush"    Color="#34425F" />
    <SolidColorBrush x:Key="HairlineBrush"      Color="#1A2337" />

    <!-- Акцент -->
    <SolidColorBrush x:Key="PrimaryBrush"       Color="#6366F1" />
    <SolidColorBrush x:Key="PrimaryHoverBrush"  Color="#7A7DF6" />
    <SolidColorBrush x:Key="PrimarySoftBrush"   Color="#1E2250" />
    <SolidColorBrush x:Key="PrimaryTextBrush"   Color="#A5B4FC" />
    <SolidColorBrush x:Key="OnAccentBrush"      Color="#FFFFFF" />

    <!-- Успех -->
    <SolidColorBrush x:Key="TealBrush"          Color="#0D9488" />
    <SolidColorBrush x:Key="TealHoverBrush"     Color="#14B8A6" />
    <SolidColorBrush x:Key="TealTextBrush"      Color="#5EEAD4" />
    <SolidColorBrush x:Key="FlashBrush"         Color="#17433F" />

    <!-- Грешка -->
    <SolidColorBrush x:Key="DangerBrush"           Color="#F87171" />
    <SolidColorBrush x:Key="DangerSolidBrush"      Color="#DC2626" />
    <SolidColorBrush x:Key="DangerSolidHoverBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerSoftBrush"       Color="#2A1520" />
    <SolidColorBrush x:Key="DangerLineBrush"       Color="#5B2533" />

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#E6EAF3" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA5BC" />
    <SolidColorBrush x:Key="MutedBrush"         Color="#677391" />
    <SolidColorBrush x:Key="HeaderTextBrush"    Color="#7D89A3" />

    <!-- Таблица, хапчета, скролбар -->
    <SolidColorBrush x:Key="RowHoverBrush"         Color="#172036" />
    <SolidColorBrush x:Key="RowSelectedBrush"      Color="#1E2250" />
    <SolidColorBrush x:Key="PillBrush"             Color="#1A2337" />
    <SolidColorBrush x:Key="PillHoverBrush"        Color="#232C4D" />
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#2A3550" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#3B4868" />

    <!-- Toast -->
    <SolidColorBrush x:Key="ToastBrush"         Color="#1C2740" />
    <SolidColorBrush x:Key="ToastBorderBrush"   Color="#2E3B5A" />
    <SolidColorBrush x:Key="ToastTextBrush"     Color="#E6EAF3" />

    <!-- Цветове на групите (фон / текст) -->
    <SolidColorBrush x:Key="GroupFamilyBg"   Color="#1B2B52" />
    <SolidColorBrush x:Key="GroupFamilyFg"   Color="#93C5FD" />
    <SolidColorBrush x:Key="GroupWorkBg"     Color="#3A2C10" />
    <SolidColorBrush x:Key="GroupWorkFg"     Color="#FCD34D" />
    <SolidColorBrush x:Key="GroupFriendsBg"  Color="#11352A" />
    <SolidColorBrush x:Key="GroupFriendsFg"  Color="#86EFAC" />
    <SolidColorBrush x:Key="GroupOtherBg"    Color="#232C3E" />
    <SolidColorBrush x:Key="GroupOtherFg"    Color="#CBD5E1" />

    <!-- Сянка на картите: в тъмна тема е по-плътна, за да отдели картата от фона -->
    <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="24" ShadowDepth="4" Direction="270"
                      Opacity="0.45" Color="#000000" />
    <DropShadowEffect x:Key="ToastShadowEffect" BlurRadius="22" ShadowDepth="6" Direction="270"
                      Opacity="0.5" Color="#000000" />

</ResourceDictionary>
